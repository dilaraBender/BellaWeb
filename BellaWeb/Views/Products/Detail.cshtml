@model BellaWeb.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<section class="product-detail-page">
    <div class="container">

        <div class="row">

            <!-- ÜRÜN FOTOĞRAFLARI -->
            <div class="col-md-7">
                <div class="product-gallery">

                    <img src="@Model.MainImage"
                         alt="@Model.Name"
                         class="detail-main-image gallery-image"
                         data-bs-toggle="modal"
                         data-bs-target="#imageModal"
                         data-image="@Model.MainImage" />

                    <div class="detail-small-images">

                        @if (!string.IsNullOrEmpty(Model.DetailImage1))
                        {
                            <img src="@Model.DetailImage1"
                                 alt="@Model.Name detay görünümü"
                                 class="gallery-image"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 data-image="@Model.DetailImage1" />
                        }

                        @if (!string.IsNullOrEmpty(Model.DetailImage2))
                        {
                            <img src="@Model.DetailImage2"
                                 alt="@Model.Name detay görünümü"
                                 class="gallery-image"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal"
                                 data-image="@Model.DetailImage2" />
                        }

                    </div>

                </div>
            </div>


            <!-- ÜRÜN BİLGİLERİ -->
            <div class="col-md-5">

                <div class="product-detail-info">

                    <span class="product-category">
                        @Model.Category
                    </span>

                    <h1>@Model.Name</h1>

                    <p>
                        @Model.Description
                    </p>


                    <!-- ÜRÜN ÖZELLİKLERİ -->
                    <div class="product-features">

                        <div class="product-feature">
                            <span>Ölçü</span>
                            <strong>@Model.Size</strong>
                        </div>

                        <div class="product-feature">
                            <span>Üretim</span>
                            <strong>El Yapımı</strong>
                        </div>

                        <div class="product-feature">
                            <span>Kişiselleştirme</span>
                            <strong>Mevcut</strong>
                        </div>

                    </div>


                    <!-- KİŞİYE ÖZEL -->
                    <div class="personalization-note">

                        <h3>Size Özel Hazırlanabilir</h3>

                        <p>
                            Bu ürün, seçtiğiniz renk ve detaylara göre size özel hazırlanabilir.
                            Seçenekler hakkında bilgi almak için bizimle iletişime geçebilirsiniz.
                        </p>

                    </div>


                    <!-- WHATSAPP -->
                    <a class="detail-whatsapp-button"
                       href="https://wa.me/905362074217?text=Merhaba%2C%20Bella%20ürünü%20hakkında%20bilgi%20almak%20istiyorum."
                       target="_blank">
                        WhatsApp'tan Sipariş Ver
                    </a>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- FOTOĞRAF BÜYÜTME MODALI -->
<div class="modal fade"
     id="imageModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content image-modal-content">

            <button type="button"
                    class="btn-close image-modal-close"
                    data-bs-dismiss="modal"
                    aria-label="Kapat">
            </button>

            <div class="modal-body text-center">

                <img id="modalImage"
                     src=""
                     alt="Büyük ürün görseli"
                     class="modal-product-image" />

            </div>

        </div>
    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const galleryImages = document.querySelectorAll(".gallery-image");
        const modalImage = document.getElementById("modalImage");

        galleryImages.forEach(function (image) {

            image.addEventListener("click", function () {

                const imageUrl = this.getAttribute("data-image");

                modalImage.src = imageUrl;

            });

        });

    });
</script>