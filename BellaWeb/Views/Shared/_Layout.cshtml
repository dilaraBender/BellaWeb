<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BellaWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BellaWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand bella-navbar-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    BELLA
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Ana Sayfa
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Products"
                               asp-action="Index">
                                Ürünler
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="customPanel">
                                Kişiye Özel
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="aboutPanel">
                                Hakkımızda
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="contactPanel">
                                İletişim
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>
        <main role="main">
            @RenderBody()
        </main>


    <footer class="bella-footer">
        <div class="container">

            <h3>BELLA HANDMADE</h3>

            <p class="footer-slogan">
                El emeğinin zarif hali.
            </p>

            <div class="footer-links">
                <a href="https://www.instagram.com/bellahandmade_tr/"
                   target="_blank">
                    Instagram
                </a>

                <span>•</span>

                <a href="https://wa.me/905362074217"
                   target="_blank">
                    WhatsApp
                </a>
            </div>

            <p class="footer-copyright">
                &copy; 2026 Bella Handmade
            </p>

        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
